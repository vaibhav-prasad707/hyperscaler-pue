pue_benchmark:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('SUPABASE_HOST') }}"
      user: postgres
      password: "{{ env_var('SUPABASE_PASSWORD') }}"
      port: 5432
      dbname: postgres
      schema: public
      threads: 4
      keepalives_idle: 0

    prod:
      type: postgres
      host: "{{ env_var('SUPABASE_HOST') }}"
      user: postgres
      password: "{{ env_var('SUPABASE_PASSWORD') }}"
      port: 5432
      dbname: postgres
      schema: public
      threads: 4
      keepalives_idle: 0
